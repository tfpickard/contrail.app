{
  "version": 8,
  "name": "Contrail Offline Basemap",
  "glyphs": "https://example.invalid/unused/{fontstack}/{range}.pbf",
  "sources": {
    "contrail": {
      "type": "vector",
      "tiles": ["http://127.0.0.1:__PORT__/tiles/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 6
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#aad3df" }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "contrail",
      "source-layer": "earth",
      "paint": { "fill-color": "#f2efe9" }
    },
    {
      "id": "landcover-forest",
      "type": "fill",
      "source": "contrail",
      "source-layer": "landcover",
      "filter": ["==", ["get", "kind"], "forest"],
      "paint": { "fill-color": "#c8dcb0", "fill-opacity": 0.6 }
    },
    {
      "id": "landcover-other",
      "type": "fill",
      "source": "contrail",
      "source-layer": "landcover",
      "filter": ["!=", ["get", "kind"], "forest"],
      "paint": { "fill-color": "#d7e6c1", "fill-opacity": 0.35 }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "contrail",
      "source-layer": "landuse",
      "paint": { "fill-color": "#e5e1d8", "fill-opacity": 0.5 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "contrail",
      "source-layer": "water",
      "paint": { "fill-color": "#aad3df" }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "contrail",
      "source-layer": "boundaries",
      "filter": ["==", ["get", "kind"], "country"],
      "paint": { "line-color": "#a89e8d", "line-width": 1.0, "line-dasharray": [3, 2] }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "contrail",
      "source-layer": "roads",
      "filter": ["match", ["get", "kind"], ["highway", "major_road"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#f5c065", "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.4, 6, 1.6] }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "contrail",
      "source-layer": "roads",
      "filter": ["match", ["get", "kind"], ["minor_road", "path"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#ffffff", "line-width": 0.5, "line-opacity": 0.8 }
    },
    {
      "id": "places-label",
      "type": "symbol",
      "source": "contrail",
      "source-layer": "places",
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["get", "name"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 2, 9, 6, 13],
        "text-font": ["Noto Sans Regular"]
      },
      "paint": {
        "text-color": "#3d3d3d",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    }
  ]
}
